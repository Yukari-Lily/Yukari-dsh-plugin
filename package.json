{
  "name": "yukari-dsh-plugin",
  "version": "1.4.0",
  "description": "自用插件合集。",
  "icon": "./icon.webp",
  "author": "YG",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./browser": "./host/browser/index.js",
    "./chats": "./host/chats/index.js",
    "./runtime": "./host/runtime/index.js",
    "./sites": "./host/sites/index.js",
    "./proxy": "./host/proxy/index.js",
    "./purge": "./host/purge/index.js",
    "./browser/locale/*.json": "./locale/browser/*.json",
    "./chats/locale/*.json": "./locale/chats/*.json",
    "./runtime/locale/*.json": "./locale/runtime/*.json",
    "./sites/locale/*.json": "./locale/sites/*.json",
    "./proxy/locale/*.json": "./locale/proxy/*.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.webp"
  },
  "files": [
    "index.js",
    "client.js",
    "host/**/*.js",
    "cordis.patch.yml",
    "locale/**/*.json",
    "icon.webp",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "sidebar",
    "panel",
    "shadowsocks",
    "static-site",
    "headless-browser",
    "purge",
    "unrestricted"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "dependencies": {
    "undici": "^8.12.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
