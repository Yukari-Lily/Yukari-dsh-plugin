{
  "name": "yukari-dsh-plugin",
  "version": "1.9.1",
  "description": "自用插件合集：会话管理、站点发布、出站代理、无限制模式（尾部锚点 + 劝退句改写 + 拒绝重试）、自动就绪的无头浏览器与运行时控制。",
  "icon": "./icon.png",
  "author": "YG",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./browser": "./host/browser/index.js",
    "./chats": "./host/chats/index.js",
    "./runtime": "./host/runtime/index.js",
    "./sites": "./host/sites/index.js",
    "./proxy": "./host/proxy/index.js",
    "./purge": "./host/purge/index.js",
    "./icon": "./icon.png",
    "./browser/icon": "./icon.png",
    "./chats/icon": "./icon.png",
    "./runtime/icon": "./icon.png",
    "./sites/icon": "./icon.png",
    "./proxy/icon": "./icon.png",
    "./purge/icon": "./icon.png",
    "./files": "./host/files/index.js",
    "./files/icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "host/**/*.js",
    "host/purge/presets/**",
    "cordis.patch.yml",
    "icon.png",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "sidebar",
    "panel",
    "shadowsocks",
    "static-site",
    "headless-browser",
    "unrestricted"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "dependencies": {
    "undici": "^8.12.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
